{
  "name": "js-discourse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Discourse and JS Community",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "db:push": "cd js-community && bun --env-file=../.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.0.13"
  }
}
